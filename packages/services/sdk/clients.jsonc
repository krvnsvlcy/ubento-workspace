{
  "defaults": {
    "host": "https://api.ubento.pro",
    "client": "fetch",
    "index": true,
    "clean": false,
  },
  "clients": [
    {
      "service": "iam-service",
      "output": "./src/clients/iam",
      "clientName": "createIamServiceClient",
      "clean": true,
      "host": "http://localhost:48041",
    },
    {
      "service": "workspace-service",
      "output": "./src/clients/workspace",
      "clientName": "createWorkspaceServiceClient",
      "clean": true,
      "host": "http://localhost:39694",
    },
    {
      "service": "module-service",
      "output": "./src/clients/module",
      "clientName": "createModuleServiceClient",
      "clean": true,
      "host": "http://localhost:28888",
    },
    {
      "service": "intelligence-service",
      "output": "./src/clients/intelligence",
      "clientName": "createIntelligenceServiceClient",
      "clean": true,
      "host": "http://localhost:44513",
    },
    {
      "service": "vertex-service",
      "output": "./src/clients/vertex",
      "clientName": "createVertexServiceClient",
      "clean": true,
      "host": "http://localhost:28642",
    },
    {
      "service": "billing-service",
      "output": "./src/clients/billing",
      "clientName": "createBillingServiceClient",
      "clean": true,
      "host": "http://localhost:6124",
    },
    {
      "service": "settings-service",
      "output": "./src/clients/settings",
      "clientName": "createSettingsServiceClient",
      "clean": true,
      "host": "http://localhost:24333",
    },
  ],
  "only": ["settings-service"],
}
