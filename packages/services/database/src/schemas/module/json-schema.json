{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Module": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "entity": {
          "type": "string",
          "default": "module"
        },
        "team_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_version_id": {
          "type": "string"
        },
        "private_version_id": {
          "type": "string"
        },
        "public_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        },
        "version": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "team_id",
        "name",
        "type",
        "latest_version_id",
        "private_version_id",
        "scope",
        "updated_at"
      ]
    },
    "ModuleVersion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "entity": {
          "type": "string",
          "default": "module_version"
        },
        "module_id": {
          "type": "string"
        },
        "author_id": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        },
        "files": {
          "type": [
            "number",
            "string",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "version": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "module_id",
        "author_id",
        "scope",
        "files",
        "updated_at"
      ]
    }
  },
  "type": "object",
  "properties": {
    "module": {
      "$ref": "#/definitions/Module"
    },
    "moduleVersion": {
      "$ref": "#/definitions/ModuleVersion"
    }
  }
}