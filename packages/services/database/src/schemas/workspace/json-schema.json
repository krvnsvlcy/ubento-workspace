          "type": "string"
        },
        "entity": {
          "type": "string",
          "default": "workspace_invite"
        },
        "workspace_id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "invited_by": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "default": "PENDING",
          "enum": [
            "PENDING",
            "ACCEPTED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "token_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revoked_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "accepted_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "email",
        "role",
        "invited_by",
        "expires_at",
        "updated_at"
      ]
    }
  },
  "type": "object",
  "properties": {
    "workspace": {
      "$ref": "#/definitions/Workspace"
    },
    "board": {
      "$ref": "#/definitions/Board"
    },
    "workspaceMembership": {
