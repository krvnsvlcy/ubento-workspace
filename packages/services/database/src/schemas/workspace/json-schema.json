{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Workspace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "entity": {
          "type": "string",
          "default": "workspace"
        },
        "team_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": [
            "number",
            "string",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "version": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "team_id",
        "name",
        "slug",
        "data",
        "updated_at"
      ]
    },
    "Board": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "entity": {
          "type": "string",
          "default": "board"
        },
        "workspace_id": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "data": {
          "type": [
            "number",
            "string",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "version": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
