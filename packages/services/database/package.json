{
  "name": "@ubento/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./iam": {
      "import": "./build/iam.js",
      "types": "./build/iam.d.ts"
    },
    "./workspace": {
      "import": "./build/workspace.js",
      "types": "./build/workspace.d.ts"
    },
    "./module": {
      "import": "./build/module.js",
      "types": "./build/module.d.ts"
    },
    "./integration": {
      "import": "./build/integration.js",
      "types": "./build/integration.d.ts"
    },
    "./intelligence": {
      "import": "./build/intelligence.js",
      "types": "./build/intelligence.d.ts"
    }
  },
  "scripts": {
    "build": "npm run generate && scripts build",
    "watch": "scripts watch",
    "generate": "npm run generate:iam && npm run generate:workspace && npm run generate:module && npm run generate:integration && npm run generate:intelligence",
    "generate:iam": "prisma generate --schema=./prisma/iam.prisma",
    "generate:workspace": "prisma generate --schema=./prisma/workspace.prisma",
    "generate:module": "prisma generate --schema=./prisma/module.prisma",
    "generate:integration": "prisma generate --schema=./prisma/integration.prisma",
    "generate:intelligence": "prisma generate --schema=./prisma/intelligence.prisma",
    "push": "npm run push:iam && npm run push:workspace && npm run push:module && npm run push:integration && npm run push:intelligence",
    "push:iam": "prisma db push --schema=./prisma/iam.prisma",
    "push:workspace": "prisma db push --schema=./prisma/workspace.prisma",
    "push:module": "prisma db push --schema=./prisma/module.prisma",
    "push:integration": "prisma db push --schema=./prisma/integration.prisma",
    "push:intelligence": "prisma db push --schema=./prisma/intelligence.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.18.0",
    "@ubento/service-toolkit": "workspace:*"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
