generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
    output        = "./generated/iam"
}

generator jsonSchema {
    provider                 = "prisma-json-schema-generator"
    output                   = "../src/schemas/iam"
    keepRelationFields       = "false"
    keepRelationScalarFields = "true"
    includeRequiredFields    = "true"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

enum Broker {
    WORKOS
}

enum TeamInviteStatus {
    PENDING
    ACCEPTED
    REVOKED
    EXPIRED
}

enum ClientStatus {
    ACTIVE
    INACTIVE
}

enum ClientCredentialStatus {
    ACTIVE
    REVOKED
    EXPIRED
}

enum SessionStatus {
    ACTIVE
    EXPIRED
    REVOKED
}

enum JwtKeyStatus {
    ACTIVE
    ROTATED
    REVOKED
}

model User {
    id             String   @id @map("_id")
    entity         String   @default("user")
    broker         Broker
    broker_id      String
    email          String   @unique
    name           String
    picture        String?
    email_verified Boolean  @default(false)
    roles          String[] @default([])

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([broker, broker_id])
    @@map("users")
}

model Team {
    id        String  @id @map("_id")
    entity    String  @default("team")
    broker    Broker
    broker_id String
    handle    String  @unique
    name      String
    picture   String?

    version    Int       @default(1)
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    @@unique([broker, broker_id])
    @@map("teams")
}

model TeamMembership {
    id      String @id @map("_id")
    entity  String @default("team_membership")
    team_id String
    user_id String
    role    String

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([team_id, user_id])
    @@index([user_id])
    @@index([team_id])
    @@map("team_memberships")
}

model TeamInvite {
    id          String           @id @map("_id")
    entity      String           @default("team_invite")
    team_id     String
    email       String
    role        String
    invited_by  String
    status      TeamInviteStatus @default(PENDING)
    token_hash  String?          @unique
    expires_at  DateTime
    revoked_at  DateTime?
    revoked_by  String?
    accepted_at DateTime?
    accepted_by String?

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([team_id, email, status])
    @@map("team_invites")
}

model Client {
    id                String       @id @map("_id")
    entity            String       @default("client")
    name              String
    description       String?
    allowed_scopes    String[]     @default([])
    allowed_audiences String[]     @default([])
    redirect_uris     String[]     @default([])
    status            ClientStatus @default(ACTIVE)
    metadata          Json?

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([status])
    @@map("clients")
}

model ClientCredential {
    id           String                 @id @map("_id")
    entity       String                 @default("client_credential")
    client_id    String
    label        String?
    secret_hash  String
    status       ClientCredentialStatus @default(ACTIVE)
    expires_at   DateTime?
    revoked_at   DateTime?
    last_used_at DateTime?
    last_used_ip String?
    metadata     Json?

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([client_id])
    @@index([status])
    @@map("client_credentials")
}

model AuthCode {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    entity     String   @default("auth_code")
    code       String   @unique
    client_id  String
    user_id    String?
    session_id String?
    scope      String[]

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    expires_at DateTime

    @@index([expires_at])
    @@map("auth_codes")
}

model Session {
    id                       String        @id @map("_id")
    entity                   String        @default("session")
    user_id                  String
    refresh_token            String        @unique
    refresh_token_rotated_at DateTime?
    status                   SessionStatus @default(ACTIVE)
    metadata                 Json?
    ip                       String?
    user_agent               String?
    revoked_at               DateTime?
    expires_at               DateTime

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([user_id])
    @@map("sessions")
}

model JwtSigningKey {
    id                    String       @id @map("_id")
    entity                String       @default("jwt_signing_key")
    algorithm             String
    public_jwk            Json
    private_jwk_encrypted String
    status                JwtKeyStatus @default(ACTIVE)

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([status])
    @@map("jwt_signing_keys")
}
