generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
    output        = "./generated/module"
}

generator jsonSchema {
    provider                 = "prisma-json-schema-generator"
    output                   = "../src/schemas/module"
    keepRelationFields       = "false"
    keepRelationScalarFields = "true"
    includeRequiredFields    = "true"
}

datasource db {
    provider = "mongodb"
    url      = env("MODULE_DATABASE_URL")
}

enum ModuleScope {
    public
    private
}

enum ModuleVersionScope {
    public
    private
}

model Module {
    id      String @id @map("_id")
    entity  String @default("module")
    team_id String

    name               String
    type               String
    summary            String?
    latest_version_id  String
    private_version_id String
    public_version_id  String?
    scope              ModuleScope

    // Named relations for quick access to specific states
    latest_version  ModuleVersion  @relation("Latest", fields: [latest_version_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
    private_version ModuleVersion  @relation("Private", fields: [private_version_id], references: [id], onUpdate: NoAction, onDelete: NoAction)
    public_version  ModuleVersion? @relation("Public", fields: [public_version_id], references: [id], onUpdate: NoAction, onDelete: NoAction)

    // Collection of all versions for history/changelog
    versions ModuleVersion[] @relation("ModuleToVersions")

    version    Int       @default(1)
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    @@index([team_id])
    @@index([scope])
    @@map("modules")
}

model ModuleVersion {
    id        String @id @map("_id")
    entity    String @default("module_version")
    module_id String

    author_id String
    scope     ModuleVersionScope
    files     Json // filename -> hash mapping (CAS)

    // Back-relations to Module
    module Module @relation("ModuleToVersions", fields: [module_id], references: [id], onDelete: Cascade)

    // Reverse named relations (required by Prisma for explicit mapping)
    latest_of_module  Module[] @relation("Latest")
    private_of_module Module[] @relation("Private")
    public_of_module  Module[] @relation("Public")

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([module_id])
    @@map("module_versions")
}

enum ModuleCollectionScope {
    public
    private
}

model ModuleCollection {
    id      String @id @map("_id")
    entity  String @default("module_collection")
    team_id String

    name       String
    summary    String?
    cover_hash String?
    scope      ModuleCollectionScope @default(private)
    module_ids String[]              @default([])

    version    Int       @default(1)
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    @@index([team_id])
    @@index([scope])
    @@map("module_collections")
}
