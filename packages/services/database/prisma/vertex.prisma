generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
    output        = "./generated/vertex"
}

generator jsonSchema {
    provider                 = "prisma-json-schema-generator"
    output                   = "../src/schemas/vertex"
    keepRelationFields       = "false"
    keepRelationScalarFields = "true"
    includeRequiredFields    = "true"
}

datasource db {
    provider = "mongodb"
    url      = env("VERTEX_DATABASE_URL")
}

model ConnectionProvider {
    id      String @id @map("_id")
    entity  String @default("connection_provider")
    team_id String

    name         String
    display_name String
    description  String?
    config       Json?

    // Relations
    connections Connection[]

    version    Int      @default(1) @db.Long
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([name, team_id])
    @@map("connection_providers")
}

model Connection {
    id      String @id @map("_id")
    entity  String @default("connection")
    team_id String

    provider_id   String
    provider      ConnectionProvider @relation(fields: [provider_id], references: [id])
    auth_strategy String?
    auth          EncryptedData?

    version    Int      @default(1) @db.Long
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([provider_id, team_id])
    @@map("connections")
}

type EncryptedData {
    iv          String
    auth_tag    String
    cipher_text String
}

model OAuthConnectionState {
    id          String @id @default(uuid()) @map("_id")
    entity      String @default("oauth_connection_state")
    team_id     String
    provider_id String

    state        String?
    redirect_uri String?
    expires_at   DateTime

    version    Int      @default(1) @db.Long
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@map("oauth_connection_states")
}

model Service {
    id      String @id @map("_id")
    entity  String @default("service")
    team_id String

    name         String
    display_name String
    description  String?
    config       Json?

    versions ServiceVersion[]

    version    Int       @default(1) @db.Long
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    @@unique([name, team_id])
    @@map("services")
}

model ServiceVersion {
    id         String  @id @map("_id")
    entity     String  @default("service_version")
    team_id    String
    service_id String
    service    Service @relation(fields: [service_id], references: [id])

    label String

    version    Int       @default(1) @db.Long
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    @@unique([service_id, label])
    @@map("service_versions")
}
