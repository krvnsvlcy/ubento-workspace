generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
    output        = "./generated/app"
}

generator jsonSchema {
    provider                 = "prisma-json-schema-generator"
    output                   = "../src/schemas/app"
    keepRelationFields       = "false"
    keepRelationScalarFields = "true"
    includeRequiredFields    = "true"
}

datasource db {
    provider = "mongodb"
    url      = env("APP_DATABASE_URL")
}

enum AppInviteStatus {
    PENDING
    ACCEPTED
    REVOKED
    EXPIRED
}

model App {
    id      String @id @map("_id")
    entity  String @default("app")
    team_id String

    name        String
    slug        String  @unique
    description String?
    data        Json

    version    Int       @default(1)
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    @@map("apps")
}

model Page {
    id     String @id @map("_id")
    entity String @default("page")
    app_id String

    name String
    data Json

    version    Int       @default(1)
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    @@map("pages")
}

model AppMembership {
    id      String @id @map("_id")
    entity  String @default("app_membership")
    app_id  String
    user_id String
    role    String

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([app_id, user_id])
    @@index([user_id])
    @@index([app_id])
    @@map("app_memberships")
}

model AppInvite {
    id     String @id @map("_id")
    entity String @default("app_invite")
    app_id String

    email       String
    role        String
    invited_by  String
    status      AppInviteStatus @default(PENDING)
    token_hash  String?         @unique
    expires_at  DateTime
    revoked_at  DateTime?
    revoked_by  String?
    accepted_at DateTime?
    accepted_by String?

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([app_id, email, status])
    @@map("app_invites")
}
