generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
    output        = "./generated/workspace"
}

generator jsonSchema {
    provider                 = "prisma-json-schema-generator"
    output                   = "../src/schemas/workspace"
    keepRelationFields       = "false"
    keepRelationScalarFields = "true"
    includeRequiredFields    = "true"
}

datasource db {
    provider = "mongodb"
    url      = env("WORKSPACE_DATABASE_URL")
}

enum WorkspaceInviteStatus {
    PENDING
    ACCEPTED
    REVOKED
    EXPIRED
}

model Workspace {
    id      String @id @map("_id")
    entity  String @default("workspace")
    team_id String

    title    String
    metadata Json
    data     Json

    version    Int       @default(1)
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    @@map("workspaces")
}


model WorkspaceMembership {
    id           String @id @map("_id")
    entity       String @default("workspace_membership")
    workspace_id String
    user_id      String
    role         String

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([workspace_id, user_id])
    @@index([user_id])
    @@index([workspace_id])
    @@map("workspace_memberships")
}

model WorkspaceInvite {
    id           String @id @map("_id")
    entity       String @default("workspace_invite")
    workspace_id String

    email       String
    role        String
    invited_by  String
    status      WorkspaceInviteStatus @default(PENDING)
    token_hash  String?               @unique
    expires_at  DateTime
    revoked_at  DateTime?
    revoked_by  String?
    accepted_at DateTime?
    accepted_by String?

    version    Int      @default(1)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([workspace_id, email, status])
    @@map("workspace_invites")
}
