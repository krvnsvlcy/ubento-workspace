{
  "defaults": {
    "host": "https://api.elll.dev",
    "client": "fetch",
    "index": true,
    "clean": false,
  },
  "clients": [
    {
      "service": "iam-service",
      "output": "./src/clients/iam",
      "clientName": "createIamServiceClient",
      "clean": true,
      // "host": "https://iam-service-660730731591.us-central1.run.app",
      "host": "http://localhost:48041",
    },
    {
      "service": "workspace-service",
      "output": "./src/clients/workspace",
      "clientName": "createWorkspaceServiceClient",
      "clean": true,
      // "host": "http://localhost:39694",
    },
    {
      "service": "intelligence-service",
      "output": "./src/clients/intelligence",
      "clientName": "createIntelligenceServiceClient",
      "host": "http://localhost:44513",
      "clean": true,
    },
    {
      "service": "configuration-service",
      "output": "./src/clients/configuration",
      "clientName": "createConfigurationServiceClient",
      "clean": true,
    },
    {
      "service": "repository-service",
      "output": "./src/clients/repository",
      "clientName": "createRepositoryServiceClient",
      // "host": "http://localhost:17195",
      "clean": true,
    },
    {
      "service": "drive-service",
      "output": "./src/clients/drive",
      "clientName": "createDriveServiceClient",
      "host": "http://localhost:30220",
      "clean": true,
    },
    {
      "service": "logging-service",
      "output": "./src/clients/logging",
      "clientName": "createLoggingServiceClient",
      "clean": true,
      "host": "http://localhost:1092",
    },
    {
      "service": "build-service",
      "output": "./src/clients/build",
      "clientName": "createBuildServiceClient",
      "clean": true,
      // "host": "http://localhost:23797",
    },
    {
      "service": "billing-service",
      "output": "./src/clients/billing",
      "clientName": "createBillingServiceClient",
      "clean": true,
      "host": "http://localhost:6124",
    },
    {
      "service": "supabase-service",
      "output": "./src/clients/supabase",
      "clientName": "createSupabaseServiceClient",
      "clean": true,
      "host": "http://localhost:48357",
    },
    {
      "service": "networking-service",
      "output": "./src/clients/networking",
      "clientName": "createNetworkingServiceClient",
      "host": "http://localhost:45495",
      "clean": true,
    },
    {
      "service": "deployment-service",
      "output": "./src/clients/deployment",
      "clientName": "createDeploymentServiceClient",
      "host": "http://localhost:27416",
      "clean": true,
    },
    {
      "service": "integration-service",
      "output": "./src/clients/integration",
      "clientName": "createIntegrationServiceClient",
      "host": "http://localhost:8083",
      "clean": true,
    },
  ],
  "only": ["intelligence-service"],
}
