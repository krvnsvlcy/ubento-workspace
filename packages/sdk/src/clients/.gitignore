# Unignore build directory
!/build
!/build/**

## Reignore sub-folders

# Node.js
/build/**/node_modules/
/build/**/.pnpm-debug.log
/build/**/.pnpm-store/

# TypeScript
/build/**/*.tsbuildinfo

# Build outputs
/build/**/dist/
/build/**/build/

# Turbo
/build/**/turbo/
/build/**/.cache/
/build/**/.turbo/

# Environment files
/build/**/.env
/build/**/.env.local
/build/**/.env.development.local
/build/**/.env.test.local
/build/**/.env.production.local

# Local
/build/**/local/