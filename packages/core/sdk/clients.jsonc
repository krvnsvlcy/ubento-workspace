{
  "defaults": {
    "host": "https://api.ubento.pro",
    "client": "fetch",
    "index": true,
    "clean": false,
  },
  "clients": [
    {
      "service": "iam-service",
      "output": "./src/clients/iam",
      "clientName": "createIamServiceClient",
      "clean": true,
    },
    {
      "service": "app-service",
      "output": "./src/clients/app",
      "clientName": "createAppServiceClient",
      "clean": true,
      "host": "http://localhost:13020",
    },
    {
      "service": "module-service",
      "output": "./src/clients/module",
      "clientName": "createModuleServiceClient",
      "clean": true,
      "host": "http://localhost:28888",
    },
  ],
}
