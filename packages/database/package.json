{
  "name": "@ubento/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./iam": {
      "import": "./build/iam.js",
      "types": "./build/iam.d.ts"
    },
    "./app": {
      "import": "./build/app.js",
      "types": "./build/app.d.ts"
    }
  },
  "scripts": {
    "build": "npm run generate && scripts build",
    "watch": "scripts watch",
    "generate": "npm run generate:iam && npm run generate:app",
    "generate:iam": "prisma generate --schema=./prisma/iam.prisma",
    "generate:app": "prisma generate --schema=./prisma/app.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.18.0",
    "@ubento/service-toolkit": "workspace:*"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
