    },
    "./visualization/*.js": {
      "types": "./build/visualization/*.d.ts",
      "import": "./build/visualization/*.js"
    },
    "./hooks/*.js": {
      "types": "./build/hooks/*.d.ts",
      "import": "./build/hooks/*.js"
    }
  },
  "scripts": {
    "build": "scripts build",
    "watch": "scripts watch"
