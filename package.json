{
  "name": "ubento",
  "version": "1.0.0",
  "private": true,
  "description": "Ubento Monorepo",
  "scripts": {
    "dev": "turbo run dev --filter=@ubento/bento.runtime --filter=@ubento/bento.app --filter=@ubento/ubento",
    "dev:apps": "turbo dev --filter='./apps/*'",
    "dev:services": "turbo dev --filter='./services/*'",
    "deploy:app:bento.runtime": "turbo deploy --filter=@ubento/bento.runtime",
    "deploy:app:bento.app": "turbo deploy --filter=@ubento/bento.app",
    "deploy:app:ubento": "turbo deploy --filter=@ubento/ubento",
    "deploy:service:billing": "turbo deploy --filter=@ubento/billing-service",
    "deploy:service:registry": "turbo deploy --filter=@ubento/registry",
    "containerize:service:iam": "docker build --secret id=github_token,env=GITHUB_TOKEN -t ubento/iam.service -f services/iam/Dockerfile .",
    "serve:service:iam": "docker run -p 3000:3000 --env-file services/iam/.env ubento/iam.service",
    "tag:service:iam": "docker tag ubento/iam.service us-central1-docker.pkg.dev/ubento-prod/ubento-services/iam.service:latest",
    "push:service:iam": "docker push us-central1-docker.pkg.dev/ubento-prod/ubento-services/iam.service:latest",
    "auth:docker": "gcloud auth configure-docker us-central1-docker.pkg.dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "@1password/sdk": "^0.4.0",
    "@manypkg/get-packages": "^3.1.0",
    "@repo/scripts": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.12",
    "prisma-json-schema-generator": "^5.1.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.9.6",
    "typescript": "^5.0.0",
    "valtio": "^2.1.2",
    "vercel": "^51.8.0"
  }
}
