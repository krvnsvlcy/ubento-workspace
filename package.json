{
  "name": "ubento",
  "version": "1.0.0",
  "private": true,
  "description": "Ubento Monorepo",
  "scripts": {
    "dev": "turbo dev",
    "dev:apps": "turbo dev --filter='./apps/*'",
    "dev:services": "turbo dev --filter='./services/*'",
    "deploy:bento-runtime": "turbo deploy --filter=tabula",
    "deploy:bento-app": "turbo deploy --filter=web",
    "deploy:ubento": "turbo deploy --filter=@ubento/platform",
    "deploy:service:iam": "turbo deploy --filter=iam",
    "deploy:service:billing": "turbo deploy --filter=billing",
    "deploy:service:registry": "turbo deploy --filter=@ubento/registry",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "turbo": "^2.9.6",
    "valtio": "^2.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
