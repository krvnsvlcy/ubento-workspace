{
  "name": "ubento",
  "version": "1.0.0",
  "private": true,
  "description": "Ubento Monorepo",
  "scripts": {
    "clean": "find . -type d \\( -name node_modules -o -name .turbo -o -name dist -o -name build \\) -prune -exec rm -rf '{}' +",
    "clean:packages": "find . -type d \\( -name node_modules \\) -prune -exec rm -rf '{}' +",
    "dev": "turbo run dev --filter=@ubento/bento.runtime.app --filter=@ubento/bento.app --filter=@ubento/component.runtime",
    "build": "turbo run build --filter=@ubento/bento.runtime --filter=@ubento/bento.app",
    "dev:web": "turbo run dev --filter=@ubento/bento.runtime --filter=@ubento/ubento",
    "dev:apps": "turbo dev --filter='./apps/*'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "@1password/sdk": "^0.4.0",
    "@manypkg/get-packages": "^3.1.0",
    "@repo/scripts": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.12",
    "prisma-json-schema-generator": "^5.1.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "^5.0.0",
    "vercel": "^51.8.0"
  },
  "dependencies": {
    "zustand": "^5.0.12"
  }
}
