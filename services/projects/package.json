    "watch": "tsc --watch",
    "dev": "tsx src/index.ts",
    "deploy": "gcloud run deploy projects-service --source ."
  },
  "dependencies": {
    "@ubento/services-common": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  }
}
