{
  "name": "@ubento/module-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@prisma/client --external:esbuild",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "scripts containerize module && scripts deploy module"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.11.2",
    "@types/mime-types": "^3.0.1",
    "@ubento/services.database": "workspace:*",
    "@ubento/services.primitives": "workspace:*",
    "@ubento/services.toolkit": "workspace:*",
    "dotenv": "^16.3.1",
    "esbuild": "^0.25.12",
    "express": "^5.2.1",
    "mime-types": "^3.0.2",
    "nanoid": "^5.1.9",
    "openapi-types": "^12.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "tsx": "^4.15.2",
    "typescript": "^5.0.4"
  }
}
