{
  "name": "@ubento/iam-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "nodemon --watch 'src' -e 'ts,js' --exec 'tsx src/index.ts'",
    "cli": "tsx src/cli/cli.ts",
    "seed": "tsx scripts/seed/seed.ts",
    "prisma": "prisma generate",
    "prisma:client": "prisma generate --generator client",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@ubento/primitives": "workspace:*",
    "@ubento/service-toolkit": "workspace:*",
    "@ubento/sdk": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "5.18.0",
    "@vinejs/vine": "^1.6.0",
    "@workos-inc/node": "^8.0.0",
    "axios": "^1.5.1",
    "casbin": "^5.35.0",
    "commander": "^14.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5",
    "express-validator": "^7.2.0",
    "jose": "^6.1.3",
    "jsonc-parser": "^3.3.1",
    "mongodb": "^6.14.2",
    "openapi-types": "^12.1.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "nodemon": "^3.0.1",
    "prisma": "^5.18.0",
    "tsx": "^4.15.2",
    "typescript": "^5.0.4"
  }
}
