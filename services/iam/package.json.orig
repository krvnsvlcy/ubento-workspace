    "@elllphnt/primitives": "^11.0.1",
    "@elllphnt/service-toolkit": "^11.0.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "5.18.0",
    "@vinejs/vine": "^1.6.0",
    "@workos-inc/node": "^8.0.0",
    "add": "^2.0.6",
    "axios": "^1.5.1",
    "casbin": "^5.35.0",
    "commander": "^14.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5",
    "express-validator": "^7.2.0",
    "jose": "^6.1.3",
    "jsonc-parser": "^3.3.1",
    "mongodb": "^6.14.2",
    "openapi-types": "^12.1.3",
    "uvu": "^0.5.6",
    "winston": "^3.13.0",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@elllphnt/auth": "^0.0.1",
    "@elllphnt/client": "^0.12.0",
    "@elllphnt/test": "^0.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^2.0.15",
    "nodemon": "^3.0.1",
    "prisma": "^5.18.0",
    "prisma-json-schema-generator": "^5.1.5",
