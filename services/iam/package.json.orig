{
  "name": "@elllphnt/iam.service",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "buildonly": "tsc",
    "clean": "rm -rf dist",
    "build": "yarn clean && yarn prisma:client && yarn buildonly",
    "start": "node dist/index.js",
    "dev": "nodemon --watch 'src' -e 'ts,js' --exec 'tsx src/index.ts'",
    "cli": "tsx src/cli/cli.ts",
    "seed": "tsx scripts/seed/seed.ts",
    "prisma": "prisma generate",
    "prisma:client": "prisma generate --generator client",
    "prisma:push": "prisma db push"
  },
  "keywords": [],
  "author": "Kervens Volcy",
  "license": "ISC",
  "dependencies": {
    "@elllphnt/access-control-service-client": "^0.1.3",
