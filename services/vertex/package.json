{
  "name": "@ubento/vertex-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@prisma/client",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "scripts containerize vertex && scripts deploy vertex"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.2",
    "@google-cloud/storage": "^7.19.0",
    "@types/multer": "^2.1.0",
    "@ubento/services.database": "workspace:*",
    "@ubento/services.primitives": "workspace:*",
    "@ubento/services.sdk": "workspace:*",
    "@ubento/services.billing-edge": "workspace:*",
    "@ubento/services.toolkit": "workspace:*",
    "@ubento/vertex.core": "workspace:*",
    "body-parser": "^2.2.0",
    "dotenv": "^16.3.1",
    "express": "^5",
    "ioredis": "^5.4.1",
    "lodash.get": "^4.4.2",
    "mime-types": "^3.0.2",
    "multer": "^2.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.0",
    "@types/express": "^5.0.3",
    "@types/lodash.get": "^4.4.9",
    "@types/mime-types": "^3.0.1",
    "@types/semver": "^7.7.1",
    "tsx": "^4.15.2",
    "typescript": "^5.0.4"
  }
}
