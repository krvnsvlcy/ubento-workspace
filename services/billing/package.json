{
  "name": "@ubento/billing-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@prisma/client --external:esbuild",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "scripts containerize billing && scripts deploy billing"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.11.2",
    "@ubento/database": "workspace:*",
    "@ubento/primitives": "workspace:*",
    "@ubento/service-toolkit": "workspace:*",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "commander": "^14.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "esbuild": "^0.25.12",
    "express": "^5.2.1",
    "express-validator": "^7.1.0",
    "jsonc-parser": "^3.3.1",
    "nanoid": "^5.1.9",
    "openapi-types": "^12.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "tsx": "^4.15.2",
    "typescript": "^5.0.4"
  }
}
