{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Thread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "entity": {
          "type": "string",
          "default": "intelligence_thread"
        },
        "organization_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "context": {
          "type": [
            "number",
            "string",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "version": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_message_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "organization_id",
        "workspace_id",
        "status",
        "updated_at"
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "entity": {
          "type": "string",
          "default": "intelligence_message"
        },
        "organization_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": [
            "number",
            "string",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "organization_id",
        "workspace_id",
        "thread_id",
        "role",
        "data",
        "updated_at"
      ]
    },
    "File": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "entity": {
          "type": "string",
          "default": "intelligence_file"
        },
        "workspace_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        },
        "version": {
          "type": "integer",
          "default": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "name",
        "type",
        "size",
        "updated_at"
      ]
    }
  },
  "type": "object",
  "properties": {
    "thread": {
      "$ref": "#/definitions/Thread"
    },
    "message": {
      "$ref": "#/definitions/Message"
    },
    "file": {
      "$ref": "#/definitions/File"
    }
  }
}