{
  "name": "@ubento/intelligence-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:@prisma/client --external:sharp",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "scripts containerize intelligence && scripts deploy intelligence"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@ubento/services.billing-edge": "workspace:*",
    "@ubento/services.database": "workspace:*",
    "@ubento/services.primitives": "workspace:*",
    "@ubento/services.sdk": "workspace:*",
    "@ubento/services.toolkit": "workspace:*",
    "ai": "^6.0.111",
    "cheerio": "^1.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-validator": "^7.1.0",
    "front-matter": "^4.0.2",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.4.1",
    "multer": "^2.1.1",
    "openapi-types": "^12.1.3",
    "sharp": "^0.34.5",
    "turndown": "^7.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.1.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2"
  }
}
