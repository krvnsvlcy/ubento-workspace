{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", ".vercel/output/**"],
      "env": [
        "NEXT_PUBLIC_WORKSPACE_RUNTIME_URL",
        "NEXT_PUBLIC_COMPONENT_RUNTIME_URL"
      ],
      "passThroughEnv": [
        "AUTH_ISSUER_URL",
        "AUTH_CLIENT_ID",
        "AUTH_CLIENT_SECRET",
        "SECRET",
        "SESSION_KEY",
        "UBENTO_API_BASE_URL",
        "UBENTO_SERVICE_URLS"
      ]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["VERCEL_TOKEN", "VERCEL_ORG_ID", "VERCEL_PROJECT_ID"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
