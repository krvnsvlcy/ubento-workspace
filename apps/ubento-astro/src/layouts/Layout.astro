---
import { ModalRenderer } from "../components/modal-renderer";
import { SessionProvider } from "../components/session";
import { getSession } from "../lib/auth";

import "@ubento/bento.style/dist/uno.css";
import "@ubento/bento.style/css/themes.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Ubento", description = "Identity and App Management" } = Astro.props;

// In Astro, we get the Request object directly via Astro.request
const session = await getSession(Astro.request);

const sessionData = session
  ? {
      userId: session.user_id,
      teamId: session.team_id,
      email: session.email,
      name: session.name,
      picture: session.picture,
    }
  : undefined;

const workspaceRuntimeUrl = import.meta.env.NEXT_PUBLIC_WORKSPACE_RUNTIME_URL || process.env.NEXT_PUBLIC_WORKSPACE_RUNTIME_URL || "http://localhost:4020";
const componentRuntimeUrl = import.meta.env.NEXT_PUBLIC_COMPONENT_RUNTIME_URL || process.env.NEXT_PUBLIC_COMPONENT_RUNTIME_URL || "http://localhost:4030";
const appUrlTemplate = import.meta.env.NEXT_PUBLIC_APP_URL_TEMPLATE || process.env.NEXT_PUBLIC_APP_URL_TEMPLATE || "";
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline define:vars={{ workspaceRuntimeUrl, componentRuntimeUrl, appUrlTemplate }}>
      window.process = window.process || {};
      window.process.env = window.process.env || {};
      window.process.env.NEXT_PUBLIC_WORKSPACE_RUNTIME_URL = workspaceRuntimeUrl;
      window.process.env.NEXT_PUBLIC_COMPONENT_RUNTIME_URL = componentRuntimeUrl;
      window.process.env.NEXT_PUBLIC_APP_URL_TEMPLATE = appUrlTemplate;
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&family=IBM+Plex+Mono:ital,wght@0,100..700;1,100..700&family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&family=IBM+Plex+Serif:ital,wght@0,100..700;1,100..700&family=Inter:wght@100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Lora:ital,wght@0,400..700;1,400..700&family=Manrope:wght@200..800&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Roboto+Slab:wght@100..900&family=Zilla+Slab:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --font-geist-sans: 'Geist', sans-serif;
        --font-inter: 'Inter', sans-serif;
        --font-manrope: 'Manrope', sans-serif;
        --font-plus-jakarta: 'Plus Jakarta Sans', sans-serif;
        --font-ibm-plex-sans: 'IBM Plex Sans', sans-serif;
        --font-fira-code: 'Fira Code', monospace;
        --font-geist-mono: 'Geist Mono', monospace;
        --font-jetbrains-mono: 'JetBrains Mono', monospace;
        --font-ibm-plex-mono: 'IBM Plex Mono', monospace;
        --font-fraunces: 'Fraunces', serif;
        --font-lora: 'Lora', serif;
        --font-newsreader: 'Newsreader', serif;
        --font-roboto-slab: 'Roboto Slab', serif;
        --font-ibm-plex-serif: 'IBM Plex Serif', serif;
        --font-zilla-slab: 'Zilla Slab', serif;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col">
    <SessionProvider session={sessionData} client:load>
      <slot />
      <ModalRenderer client:load />
    </SessionProvider>
  </body>
</html>
